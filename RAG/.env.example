# ============================================
# RAG PRODUCTION - Variables de Entorno
# ============================================

# OpenAI API Key (REQUERIDO)
# Obtén tu API key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Qdrant Local URL (OPCIONAL - default: http://localhost:6333)
# Para usar Qdrant con Docker localmente
QDRANT_URL=http://localhost:6333

# Nombre de la colección en Qdrant (OPCIONAL - default: metabolomics_agent_db)
COLLECTION_NAME=metabolomics_agent_db

# Ruta al PDF (OPCIONAL - default: bioactives_sample.pdf)
PDF_PATH=bioactives_sample.pdf

# ============================================
# INSTRUCCIONES DE USO
# ============================================
# 1. Copia este archivo a .env:
#    cp .env.example .env
#
# 2. Edita .env con tus valores reales
#
# 3. El script cargará automáticamente las variables
#    (gracias a python-dotenv)
