# .env.example
# This file is used by load_dotenv to load environment variables
# Copy this file to `.env` and fill in the real values

# ==============================
# Required for model usage
# ==============================
OPENAI_API_KEY="your-openai-api-key"

# ==============================
# Optional: LangSmith (evaluation & tracing)
# ==============================
LANGSMITH_API_KEY="your-langsmith-api-key"
LANGSMITH_TRACING=true
LANGSMITH_PROJECT="lc-essentials"

# ==============================
# Qdrant Vector Database
# ==============================
QDRANT_URL="https://your-qdrant-instance.cloud.qdrant.io:6333"
QDRANT_API_KEY="your-qdrant-api-key"

# ==============================
# Data / Paths
# ==============================
PDF_PATH="./bioactives_sample.pdf"
